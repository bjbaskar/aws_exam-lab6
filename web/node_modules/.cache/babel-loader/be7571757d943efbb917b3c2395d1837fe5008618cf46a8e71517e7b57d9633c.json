jsxs","_jsxs","props","username","setUsername","password","setPassword","loggingIn","setLoggingIn","history","authenticate","LoggedIn","onSubmit","event","preventDefault","then","data","push","catch","err","children","to","Group","controlId","Label","srOnly","Prepend","Text","Control","value","onChange","target","type","variant"],"sources":["/home/ec2-user/environment/web/src/Routes/Login.js"],"sourcesContent":["import React, { useState, useContext } from \"react\";\nimport { AccountContext } from '../Components/Auth/Accounts';\nimport {Container, Form, Button, InputGroup} from 'react-bootstrap';\nimport { Redirect, useHistory } from 'react-router-dom';\nimport LoadingSpinner from '../Components/LoadingSpinner';\n\nexport default (props) => {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [loggingIn, setLoggingIn] = useState(false);\n  const history = useHistory();\n\n  const { authenticate, LoggedIn } = useContext(AccountContext);\n\n  const onSubmit = event => {\n    event.preventDefault();\n    setLoggingIn(true)\n    authenticate(username, password)\n      .then(data => {\n        history.push(\"/\")\n      })\n      .catch(err => {\n        setLoggingIn(false)\n      })\n  };\n\n  return (\n    <Container>\n      {(LoggedIn) ? <Redirect to='/' /> :\n      <Form onSubmit={onSubmit}>\n        <Form.Group controlId=\"username\">\n          <Form.Label srOnly>\n            Username:\n          </Form.Label>\n          <InputGroup>\n            <InputGroup.Prepend>\n                <InputGroup.Text>Username:</InputGroup.Text>\n              </InputGroup.Prepend>\n              <Form.Control value={username} onChange={event => setUsername(event.target.value)}></Form.Control>\n          </InputGroup>\n        </Form.Group>\n        <Form.Group controlId=\"password\">\n          <Form.Label srOnly>\n            Password:\n          </Form.Label>\n          <InputGroup>\n            <InputGroup.Prepend>\n                <InputGroup.Text>Password:</InputGroup.Text>\n              </InputGroup.Prepend>\n              <Form.Control type=\"password\" value={password} onChange={event => setPassword(event.target.value)}></Form.Control>\n          </InputGroup>\n        </Form.Group>\n        <Button variant=\"primary\" type=\"submit\">{(loggingIn) ? <LoadingSpinner /> : 'Login'}</Button>\n      </Form>\n    }\n    </Container>\n    \n  );\n};"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,QAAQ,CAAEC,UAAU,KAAQ,OAAO,CACnD,OAASC,cAAc,KAAQ,6BAA6B,CAC5D,OAAQC,SAAS,CAAEC,IAAI,CAAEC,MAAM,CAAEC,UAAU,KAAO,iBAAiB,CACnE,OAASC,QAAQ,CAAEC,UAAU,KAAQ,kBAAkB,CACvD,MAAO,CAAAC,cAAc,KAAM,8BAA8B,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAE1D,cAAgB,CAAAC,KAAK,EAAK,CACxB,KAAM,CAACC,QAAQ,CAAEC,WAAW,CAAC,CAAGhB,QAAQ,CAAC,EAAE,CAAC,CAC5C,KAAM,CAACiB,QAAQ,CAAEC,WAAW,CAAC,CAAGlB,QAAQ,CAAC,EAAE,CAAC,CAC5C,KAAM,CAACmB,SAAS,CAAEC,YAAY,CAAC,CAAGpB,QAAQ,CAAC,KAAK,CAAC,CACjD,KAAM,CAAAqB,OAAO,CAAGb,UAAU,CAAC,CAAC,CAE5B,KAAM,CAAEc,YAAY,CAAEC,QAAS,CAAC,CAAGtB,UAAU,CAACC,cAAc,CAAC,CAE7D,KAAM,CAAAsB,QAAQ,CAAGC,KAAK,EAAI,CACxBA,KAAK,CAACC,cAAc,CAAC,CAAC,CACtBN,YAAY,CAAC,IAAI,CAAC,CAClBE,YAAY,CAACP,QAAQ,CAAEE,QAAQ,CAAC,CAC7BU,IAAI,CAACC,IAAI,EAAI,CACZP,OAAO,CAACQ,IAAI,CAAC,GAAG,CAAC,CACnB,CAAC,CAAC,CACDC,KAAK,CAACC,GAAG,EAAI,CACZX,YAAY,CAAC,KAAK,CAAC,CACrB,CAAC,CAAC,CACN,CAAC,CAED,mBACET,IAAA,CAACR,SAAS,EAAA6B,QAAA,CACNT,QAAQ,cAAIZ,IAAA,CAACJ,QAAQ,EAAC0B,EAAE,CAAC,GAAG,CAAE,CAAC,cACjCpB,KAAA,CAACT,IAAI,EAACoB,QAAQ,CAAEA,QAAS,CAAAQ,QAAA,eACvBnB,KAAA,CAACT,IAAI,CAAC8B,KAAK,EAACC,SAAS,CAAC,UAAU,CAAAH,QAAA,eAC9BrB,IAAA,CAACP,IAAI,CAACgC,KAAK,EAACC,MAAM,MAAAL,QAAA,CAAC,WAEnB,CAAY,CAAC,cACbnB,KAAA,CAACP,UAAU,EAAA0B,QAAA,eACTrB,IAAA,CAACL,UAAU,CAACgC,OAAO,EAAAN,QAAA,cACfrB,IAAA,CAACL,UAAU,CAACiC,IAAI,EAAAP,QAAA,CAAC,WAAS,CAAiB,CAAC,CAC1B,CAAC,cACrBrB,IAAA,CAACP,IAAI,CAACoC,OAAO,EAACC,KAAK,CAAE1B,QAAS,CAAC2B,QAAQ,CAAEjB,KAAK,EAAIT,WAAW,CAACS,KAAK,CAACkB,MAAM,CAACF,KAAK,CAAE,CAAe,CAAC,EAC1F,CAAC,EACH,CAAC,cACb5B,KAAA,C