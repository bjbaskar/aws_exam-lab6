-bootstrap';\nimport UserPool from '../UserPool';\n\nexport default () => {\n  const [username, setUsername] = useState('');\n  const [password, setPassword] = useState('');\n\n  const onSubmit = event => {\n    event.preventDefault();\n\n    UserPool.signUp(username, password, [], null, (err, data) => {\n      if (err) console.error(err);\n      console.log(data);\n    });\n  };\n\n  return (\n    <Container>\n      <Form onSubmit={onSubmit}>\n        <Form.Group controlId=\"username\">\n          <Form.Label srOnly>\n            Username:\n          </Form.Label>\n          <InputGroup>\n            <InputGroup.Prepend>\n                <InputGroup.Text>Username:</InputGroup.Text>\n              </InputGroup.Prepend>\n              <Form.Control value={username} onChange={event => setUsername(event.target.value)}></Form.Control>\n          </InputGroup>\n        </Form.Group>\n        <Form.Group controlId=\"password\">\n          <Form.Label srOnly>\n            Password:\n          </Form.Label>\n          <InputGroup>\n            <InputGroup.Prepend>\n                <InputGroup.Text>Password:</InputGroup.Text>\n              </InputGroup.Prepend>\n              <Form.Control type=\"password\" value={password} onChange={event => setPassword(event.target.value)}></Form.Control>\n          </InputGroup>\n        </Form.Group>\n\n        <Button variant=\"primary\" type=\"submit\">Signup</Button>\n      </Form>\n    </Container>\n  );\n};"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,QAAQ,KAAQ,OAAO,CACvC,OAAQC,SAAS,CAAEC,IAAI,CAAEC,MAAM,CAAEC,UAAU,KAAO,iBAAiB,CACnE,MAAO,CAAAC,QAAQ,KAAM,aAAa,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAEnC,cAAe,IAAM,CACnB,KAAM,CAACC,QAAQ,CAAEC,WAAW,CAAC,CAAGX,QAAQ,CAAC,EAAE,CAAC,CAC5C,KAAM,CAACY,QAAQ,CAAEC,WAAW,CAAC,CAAGb,QAAQ,CAAC,EAAE,CAAC,CAE5C,KAAM,CAAAc,QAAQ,CAAGC,KAAK,EAAI,CACxBA,KAAK,CAACC,cAAc,CAAC,CAAC,CAEtBX,QAAQ,CAACY,MAAM,CAACP,QAAQ,CAAEE,QAAQ,CAAE,EAAE,CAAE,IAAI,CAAE,CAACM,GAAG,CAAEC,IAAI,GAAK,CAC3D,GAAID,GAAG,CAAEE